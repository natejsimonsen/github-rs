<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's macOS bundle info. scripts/bundle-macos.sh and nix/package.nix fill in @VERSION@. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>GitHub PRs</string>
  <key>CFBundleDisplayName</key><string>GitHub PRs</string>
  <key>CFBundleIdentifier</key><string>dev.github-prs</string>
  <key>CFBundleExecutable</key><string>github-prs</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- github-prs://github.com/owner/repo/pull/123 opens that PR in the app. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>Pull request link</string>
      <key>CFBundleURLSchemes</key><array><string>github-prs</string></array>
    </dict>
  </array>
</dict>
</plist>
